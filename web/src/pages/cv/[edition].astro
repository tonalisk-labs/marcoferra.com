---
// The CV's printable documents, built only when scripts/cv-pdf.ts asks (CV_PRINT=1), into a
// build of its own, so the site never publishes them. The recruiter edition needs its overlay, the
// JSON file CV_RECRUITER names.
import { readFileSync } from 'node:fs';
import process from 'node:process';

import CvDocument from '../../components/cv-document.astro';
import { frontmatter } from '../../data/cv.md';
import { asCv, asRecruiter, type Edition, editionOf } from '../../lib/cv.ts';

import '../../styles/cv-print.css';

export const getStaticPaths = (): { params: { edition: Edition } }[] =>
  process.env['CV_PRINT'] === '1'
    ? [
        { params: { edition: 'public' } },
        ...(process.env['CV_RECRUITER'] === undefined ? [] : [{ params: { edition: 'recruiter' } }]),
      ]
    : [];

const { edition } = Astro.params as { edition: Edition };
const overlay = process.env['CV_RECRUITER'];
const recruiter =
  edition === 'recruiter' && overlay !== undefined
    ? asRecruiter(JSON.parse(readFileSync(overlay, 'utf8')))
    : undefined;
const cv = editionOf(asCv(frontmatter), recruiter);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{cv.name}, CV</title>
  </head>
  <body>
    <CvDocument cv={cv} />
  </body>
</html>
