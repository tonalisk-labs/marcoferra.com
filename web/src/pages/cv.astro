---
// The public CV never names the current employer.
import { BADGE, BADGE_TONES, button, CARD, DISPLAY, LEAD } from '@tonalisk-labs/kit/theme';
import type { Thing } from 'schema-dts';

import { frontmatter } from '../data/cv.md';
import { TEXT_LINK } from '../booking/classes.ts';
import Section from '../components/section.astro';
import Layout from '../layouts/layout.astro';
import { asCv, editionOf, monthOf, yearOf } from '../lib/cv.ts';

const cv = editionOf(asCv(frontmatter));
const home = new URL('/', Astro.site).href;
const profile: Thing = {
  '@type': 'ProfilePage',
  name: `${cv.name}, CV`,
  url: new URL('/cv/', Astro.site).href,
  mainEntity: { '@id': `${home}#person` },
};
const glance = [
  { value: '18+', label: 'years leading delivery' },
  { value: '4', label: 'sectors, from labs to software' },
  { value: 'Black Belt', label: 'Lean Six Sigma' },
  { value: 'SAFe 6', label: 'Scrum Master' },
];
const META = 'text-sm text-slate-600';
/** A card's look without its padding, which is tighter on a phone beside the rail. */
const CARD_SURFACE = 'bg-white shadow-sm ring-1 ring-slate-900/5';
---

<Layout
  title="Marco Ferra, CV: Programme Manager"
  description="CV of Marco Ferra: 18+ years leading delivery, transformation and operational excellence across media and technology, biopharma, mobility and engineering."
  image="cv"
  jsonLd={[profile]}
>
  <article>
    <header class="flex flex-col gap-4">
      <hgroup class="flex flex-col gap-4">
        <h1 class={DISPLAY}>{cv.name}</h1>
        <p class="text-xl font-semibold text-primary-700">{cv.title}</p>
      </hgroup>
      <p class={LEAD}>{cv.summary}</p>
      <p class="flex flex-wrap gap-3 print:hidden">
        <a href="/Marco-Ferra-CV.pdf" download class={button('primary')}>
          Download the CV (PDF)
        </a>
        <a href="/work-with-me/" class={button('light')}>Work with me</a>
      </p>
      <p>
        Full CV on request:
        <a href={`mailto:${cv.email}?subject=Full%20CV`} class={TEXT_LINK}>{cv.email}</a>
      </p>
    </header>

    <section aria-label="At a glance" class="mt-10">
      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          glance.map(({ value, label }) => (
            <div class="flex flex-col-reverse gap-1 rounded-xl bg-primary-50 p-4 ring-1 ring-primary-700/10">
              <dt class="text-sm text-slate-700">{label}</dt>
              <dd class="text-2xl font-bold tracking-tight text-primary-800">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <Section id="results" title="Selected results" class="mt-12 break-inside-avoid-page">
      <ul class="flex flex-col gap-3">
        {
          cv.achievements.map((achievement) => (
            <li class="border-s-4 border-primary-600 ps-4 text-pretty">{achievement}</li>
          ))
        }
      </ul>
    </Section>

    <Section id="experience" title="Experience" class="mt-12">
      <ol class="mt-2 flex flex-col">
        {
          cv.experience.map((job, index) => (
            <li class="flex gap-3 sm:gap-5">
              <p class="hidden w-11 shrink-0 pt-6 text-end text-sm font-semibold text-slate-600 tabular-nums sm:block print:hidden">
                {yearOf(job.start)}
              </p>
              <div aria-hidden="true" class="flex shrink-0 flex-col items-center print:hidden">
                <span
                  class:list={[
                    'mt-5 size-3 rounded-full ring-4 sm:mt-7',
                    job.partTime ? 'bg-slate-400 ring-slate-100' : 'bg-primary-600 ring-primary-100',
                  ]}
                />
                {index < cv.experience.length - 1 && <span class="mt-2 w-0.5 flex-1 bg-slate-200" />}
              </div>
              <article
                class:list={[
                  'mb-6 flex min-w-0 flex-1 flex-col gap-3 break-inside-avoid',
                  'rounded-2xl p-4 sm:p-6',
                  job.partTime ? 'ring-1 ring-slate-200' : CARD_SURFACE,
                ]}
              >
                <p class="flex flex-wrap gap-2">
                  <span class:list={[BADGE, BADGE_TONES.secondary]}>{job.sector}</span>
                  {job.partTime && <span class:list={[BADGE, BADGE_TONES.grey]}>Part-time</span>}
                </p>
                <h3 class="text-lg font-semibold text-balance">
                  {job.role}, <span class="text-primary-700">{job.company}</span>
                </h3>
                <p class={META}>
                  <time datetime={job.start}>{monthOf(job.start)}</time> to{' '}
                  {job.end === 'present' ? (
                    'Present'
                  ) : (
                    <time datetime={job.end}>{monthOf(job.end)}</time>
                  )}{' '}
                  · {job.location}
                </p>
                <p class="text-slate-700 text-pretty">{job.context}</p>
                {job.steps.length > 0 && (
                  <ol aria-label="Progression" class="flex flex-wrap items-center gap-2">
                    {job.steps.map((step) => (
                      <li class:list={[BADGE, BADGE_TONES.grey]}>{step}</li>
                    ))}
                  </ol>
                )}
                <ul class="flex list-disc flex-col gap-1.5 ps-5 marker:text-primary-600">
                  {job.highlights.map((highlight) => (
                    <li class="text-pretty">{highlight}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="alongside" title="Alongside" class="mt-8 break-inside-avoid-page">
      <p class="text-slate-700">What I do outside the day job, and where it shows.</p>
      <ul class="mt-2 grid gap-4 sm:grid-cols-2">
        {
          cv.alongside.map((item) => (
            <li class={`${CARD} flex flex-col gap-2`}>
              <h3 class="font-semibold">{item.title}</h3>
              <p class="text-sm text-slate-700 text-pretty">{item.detail}</p>
              {item.url !== undefined && (
                <a href={item.url} class={`${TEXT_LINK} mt-auto text-sm font-medium print:hidden`}>
                  {item.cta ?? item.title}
                </a>
              )}
            </li>
          ))
        }
        <li class={`${CARD} flex flex-col gap-2`}>
          <h3 class="font-semibold">Speaker</h3>
          <ul class="flex flex-col gap-1 text-sm text-slate-700">
            {cv.speaking.map((talk) => <li class="text-pretty">{talk.title}</li>)}
          </ul>
        </li>
      </ul>
    </Section>

    <Section id="skills" title="Skills" class="mt-12 break-inside-avoid-page">
      <div class="flex flex-col gap-4">
        {
          cv.skills.map(({ group, items }) => (
            <div class="flex flex-col gap-2">
              <h3 class="font-semibold">{group}</h3>
              <ul class="flex flex-wrap gap-2">
                {items.map((item) => (
                  <li class:list={[BADGE, BADGE_TONES.grey]}>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="certifications" title="Certifications" class="mt-12 break-inside-avoid-page">
      <ul class="flex flex-col gap-2">
        {
          cv.certifications.map((certificate) => (
            <li>
              <strong>{certificate.name}</strong>, {certificate.detail}
              {certificate.pdf === undefined ? undefined : (
                <>
                  {' '}
                  <a href={certificate.pdf} class="underline print:hidden">
                    certificate (PDF)
                  </a>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="education" title="Education" class="mt-12 break-inside-avoid-page">
      <ul class="flex flex-col gap-2">
        {
          cv.education.map((course) => (
            <li>
              <strong>{course.qualification}</strong>, {course.institution}, {course.year}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="languages" title="Languages" class="mt-12 break-inside-avoid-page">
      <p>{cv.languages.join(', ')}</p>
    </Section>

    <Section id="next" title="Next step" class="mt-12 print:hidden">
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class={`${CARD} flex flex-col gap-3`}>
          <h3 class="text-lg font-semibold">Hiring for a role?</h3>
          <p class="text-slate-700">
            Book a free 20-minute Role Conversation and we spend it on scope and fit.
          </p>
          <a href="/work-with-me/#roles" class={`${button('primary')} mt-auto w-fit`}>Roles</a>
        </li>
        <li class={`${CARD} flex flex-col gap-3`}>
          <h3 class="text-lg font-semibold">Want an experienced view?</h3>
          <p class="text-slate-700">
            Start with a free introductory call on delivery, careers or leadership.
          </p>
          <a href="/work-with-me/#advisory" class={`${button('light')} mt-auto w-fit`}>Advisory</a>
        </li>
      </ul>
    </Section>
  </article>
</Layout>
