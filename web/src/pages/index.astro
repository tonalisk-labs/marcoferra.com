---
import { button, CARD_LINK, DISPLAY, LEAD } from '@tonalisk-labs/kit/theme';

import Layout from '../layouts/layout.astro';
import { astroNotes } from '../lib/json-ld.ts';

const now = [
  {
    title: 'Delivery leadership',
    text: 'I lead delivery governance and improvement in a large engineering organisation. 18+ years across four sectors.',
    href: '/work-with-me/#full-cv',
    cta: 'Ask for my CV',
  },
  {
    title: 'Mentoring and advisory',
    text: 'I help people step into leadership, get promoted and manage demanding stakeholders. The first call is free.',
    href: '/work-with-me/',
    cta: 'Work with me',
  },
  {
    title: 'Astro Notes',
    text: 'End-to-end encrypted notes that I build and run myself with AI. Free for good, hosted in Germany, no trackers.',
    href: 'https://www.astronotes.eu/',
    cta: 'Try it free',
  },
];
---

<Layout
  title="Marco Ferra: engineering excellence and transformation"
  description="Marco Ferra: delivery governance, DORA metrics and Lean Six Sigma for engineering at scale. 18 years, four sectors, and a product he builds and runs with AI."
  image="home"
  jsonLd={[astroNotes(Astro.site)]}
>
  <section aria-labelledby="hero" class="flex flex-col gap-6 py-6">
    <h1 id="hero" class={DISPLAY}>
      Marco Ferra: engineering excellence <span class="text-primary-700">and transformation</span>
    </h1>
    <p class={LEAD}>
      Delivery governance, DORA metrics and Lean Six Sigma for engineering organisations at scale. 18
      years, four sectors, and a product I build and run myself with AI.
    </p>
    <p class="flex flex-wrap gap-4">
      <a href="/work-with-me/" class={button('primary', 'lg')}>
        Work with me
      </a>
    </p>
  </section>

  <section aria-labelledby="now" class="mt-8 flex flex-col gap-4">
    <h2 id="now" class="text-2xl font-semibold tracking-tight">What I do now</h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        now.map(({ title, text, href, cta }) => (
          <li>
            <a href={href} class={`${CARD_LINK} flex h-full flex-col gap-2`}>
              <h3 class="text-lg font-semibold">{title}</h3>
              <p class="text-sm text-slate-700 text-pretty">{text}</p>
              <span class="mt-auto pt-2 font-medium text-primary-700">{cta}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
