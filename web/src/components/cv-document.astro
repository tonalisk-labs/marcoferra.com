---
// The CV as one document in either edition: standard section names, dates on their own line and
// real lists, so the PDF's tags and text read in order for a parser and a screen reader.
import { type CvEdition, periodOf } from '../lib/cv.ts';

interface Props {
  cv: CvEdition;
}

const { cv } = Astro.props;
const recruiter = cv.edition === 'recruiter';
/** A URL as it reads in print: no scheme, no www, no trailing slash. */
const bare = (url: string): string =>
  url.replace(/^https:\/\/(?:www\.)?/u, '').replace(/\/$/u, '');
const meta = (job: CvEdition['experience'][number]): string =>
  [periodOf(job), job.location, ...(job.partTime ? ['Part-time'] : [])].join(' · ');
---

<article>
  <header class="cv-head">
    <h1 class="cv-name">{cv.name}</h1>
    <p class="cv-tagline">{cv.tagline}</p>
    <p class="cv-contact">
      {cv.location}
      {' · '}<a href={`mailto:${cv.email}`}>{cv.email}</a>
      {
        cv.phone !== undefined && (
          <>
            {' · '}
            <a href={`tel:${cv.phone.replaceAll(' ', '')}`}>{cv.phone}</a>
          </>
        )
      }
      {' · '}<a href={cv.linkedin}>{bare(cv.linkedin)}</a>
      {' · '}<a href={cv.website}>{bare(cv.website)}</a>
    </p>
    {!recruiter && <p class="cv-request">Full CV on request: {cv.email}</p>}
  </header>

  <section class="cv-section" aria-labelledby="summary">
    <h2 id="summary">Summary</h2>
    <p class="cv-summary">{cv.summary}</p>
  </section>

  <section class="cv-section" aria-labelledby="achievements">
    <h2 id="achievements">Key achievements</h2>
    <ul class="cv-band">
      {cv.achievements.map((achievement) => <li>{achievement}</li>)}
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    {
      cv.experience.map((job) => (
        <div class="job">
          <h3>
            <span>{job.role}</span>, <span class="job-company">{job.company}</span>
          </h3>
          <p class="job-meta">{meta(job)}</p>
          <p class="job-context">
            {job.context}
            {job.steps.length > 0 && <> Progressed from {job.steps.join(' to ')}.</>}
          </p>
          <ul>
            {job.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-section cv-skills" aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    {
      cv.skills.map(({ group, items }) => (
        <p>
          <span class="cv-label">{group}:</span> {items.join(', ')}
        </p>
      ))
    }
  </section>

  <section class="cv-section" aria-labelledby="certifications">
    <h2 id="certifications">Certifications</h2>
    <ul class="cv-lines">
      {
        cv.certifications.map((certificate) => (
          <li>
            <span class="cv-label">{certificate.name},</span>
            <span class="cv-muted">{certificate.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="education">
    <h2 id="education">Education</h2>
    <ul class="cv-lines">
      {
        cv.education.map((course) => (
          <li>
            <span class="cv-label">{course.qualification}</span>, {course.institution}, {course.year}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="alongside">
    <h2 id="alongside">Projects and mentoring</h2>
    <ul class="cv-lines">
      {
        cv.alongside.map((item) => (
          <li>
            <span class="cv-label">{item.title}</span>
            {item.url !== undefined && <span class="cv-muted"> ({bare(item.url)})</span>}: {item.detail}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="speaking">
    <h2 id="speaking">Speaking and publications</h2>
    <ul class="cv-lines">
      {
        [...cv.speaking, ...cv.publications].map((item) => (
          <li>
            <span class="cv-label">{item.title},</span>
            <span class="cv-muted">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="languages">
    <h2 id="languages">Languages</h2>
    <p>{cv.languages.join(', ')}</p>
  </section>
</article>
