---
// A titled part of a page: the heading names the section for assistive technology.
interface Props {
  id: string;
  title: string;
  /** Spacing or print rules of the page around it. */
  class?: string;
}

const { id, title, class: around = '' } = Astro.props;
---

<section aria-labelledby={id} class={`flex flex-col gap-2 ${around}`}>
  <h2 id={id} class="text-2xl font-semibold tracking-tight text-balance">{title}</h2>
  <slot />
</section>
